{
  "name": "@rytrox/time",
  "version": "2.0.5",
  "description": "Useful Date and Time-Types for TypeScript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rytrox/time.git"
  },
  "private": false,
  "keywords": [
    "typescript",
    "date",
    "time",
    "localdate",
    "localtime",
    "utility",
    "library"
  ],
  "files": [
    "dist"
  ],
  "license": "ISC",
  "author": "Timo Taubmann <timeout@rytrox.de>",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./yup": {
      "react-native": "./dist/yup/index.js",
      "types": "./dist/yup/index.d.ts",
      "import": "./dist/yup/index.js",
      "require": "./dist/yup/index.cjs",
      "default": "./dist/yup/index.js"
    },
    "./zod": {
      "react-native": "./dist/zod/index.js",
      "types": "./dist/zod/index.d.ts",
      "import": "./dist/zod/index.js",
      "require": "./dist/zod/index.cjs",
      "default": "./dist/zod/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "jest",
    "test:ci": "jest --ci --coverage",
    "release": "npm publish"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.25",
    "eslint": "^10.11.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.12",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "peerDependencies": {
    "yup": "^1.7.1",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.27.2": true,
    "unrs-resolver@1.12.2": true
  }
}
